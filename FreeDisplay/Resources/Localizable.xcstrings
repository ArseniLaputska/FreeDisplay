    "%@ / %@" : {
      "comment" : "A subheading displaying the vendor and product ID of a display. The first argument is the vendor ID. The second argument is the product ID.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@%%" : {
      "comment" : "A label showing the current brightness level in the UI. The value is rounded to the nearest whole number.",
      "isCommentAutoGenerated" : true
    },
    "%@×%@%@ · %@Hz" : {
      "comment" : "A label displaying the resolution, refresh rate, and whether the display is in HiDPI mode. The first argument is the width of the display in pixels. The second argument is the height of the display in pixels. The third argument is whether the display is in HiDPI mode. The fourth argument is the refresh rate of the display.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@×%2$@%3$@ · %4$@Hz"
